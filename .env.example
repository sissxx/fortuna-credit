# Required for the /apply form to email applications (src/app/api/apply/route.ts).
# Get a key at https://resend.com — the free tier is enough to start.
RESEND_API_KEY=

# Optional: sender address for outgoing application emails. Until you verify
# your own domain with Resend, leave this unset — it falls back to
# Resend's shared onboarding@resend.dev sender, which works out of the box.
# RESEND_FROM_EMAIL="Fortuna Credit <apply@yourdomain.com>"
